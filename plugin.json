{
  "id": "neodex.alignements",
  "name": "Alignements",
  "version": "1.3.0",
  "author": "NDesumeur",
  "description": "Jeu de réflexion sur un plateau de 9 × 9 : clique sur une bille puis sur une case libre pour la déplacer par un chemin dégagé, et forme des lignes de cinq billes de la même couleur, droites ou en diagonale. Chaque coup sans ligne fait tomber trois nouvelles billes ; plus la ligne est longue, plus elle rapporte. La partie se termine quand le plateau est plein. Mode puzzle : dix plateaux à vider en un nombre de coups donné.",
  "icon": "icon.png",
  "entry": "index.js",
  "view": "alignements",
  "neobase": ">=4.0.0",
  "type": "app",
  "category": "Jeux",
  "compatibility": [
    "windows",
    "linux"
  ],
  "syncMode": "aucune",
  "syncInfo": "Rien n'est synchronisé : tes records restent sur cet appareil.",
  "mobile": false,
  "system": false,
  "dependencies": {},
  "sdk": "2.1.0",
  "permissions": [
    "storage"
  ],
